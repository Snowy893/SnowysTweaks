{
    "type": "origins:multiple",
    "resource": {
        "type": "origins:resource",
        "min": 0,
        "max": 100,
        "min_action": {
            "type": "origins:set_fall_distance",
            "fall_distance": 0
        },
        "hud_render": {
            "should_render": false
        }
    },
    "key_press": {
        "type": "origins:active_self",
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:change_resource",
                    "resource": "*:*_resource",
                    "change": 100
                },
                {
                    "type": "origins:delay",
                    "ticks": 10,
                    "action": {
                        "type": "origins:set_on_fire",
                        "duration": 4.5
                    }
                },
                {
                    "type": "origins:add_velocity",
                    "space": "local_horizontal",
                    "z": 0.2,
                    "client": true,
                    "server": false
                },
                {
                    "type": "origins:add_velocity",
                    "space": "world",
                    "y": 0.7,
                    "client": true,
                    "server": false
                },
                {
                    "type": "origins:play_sound",
                    "sound": "minecraft:entity.llama.spit",
                    "volume": 4,
                    "pitch": 0.3
                },
                {
                    "type": "origins:exhaust",
                    "amount": 1.5
                }
            ]
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:food_level",
                    "comparison": ">",
                    "compare_to": 6
                },
                {
                    "type": "origins:resource",
                    "resource": "*:*_resource",
                    "comparison": "==",
                    "compare_to": 0
                },
                {
                    "type": "origins:on_block",
                    "inverted": true
                },
                {
                    "type": "origins:in_block_anywhere",
                    "block_condition": {
                        "type": "origins:in_tag",
                        "tag": "snowy:fluid"
                    },
                    "comparison": ">=",
                    "compare_to": 1,
                    "inverted": true
                },
                {
                    "type": "origins:in_rain",
                    "inverted": true
                }
            ]
        },
        "key": {
            "key": "key.origins.primary_active",
            "continuous": false
        },
        "hud_render": {
            "bar_index": 3,
            "should_render": true
        },
        "cooldown": 1000
    },
    "over_time": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:*_resource",
            "change": -20
        },
        "condition": {
            "type": "origins:resource",
            "resource": "*:*_resource",
            "comparison": ">",
            "compare_to": 0
        },
        "interval": 20
    },
    "float": {
        "type": "origins:modify_falling",
        "velocity": -0.05,
        "take_fall_damage": true,
        "condition": {
            "type": "origins:resource",
            "resource": "*:*_resource",
            "comparison": ">",
            "compare_to": 0
        }
    },
    "cancel_fall_damage": {
        "type": "origins:invulnerability",
        "damage_condition": {
            "type": "origins:name",
            "name": "fall"
        },
        "condition": {
            "type": "origins:resource",
            "resource": "*:*_resource",
            "comparison": ">",
            "compare_to": 0
        }
    },
    "flame_arrow": {
        "type": "origins:modify_projectile_damage",
        "target_action": {
            "type": "origins:set_on_fire",
            "duration": 5
        },
        "condition": {
            "type": "origins:resource",
            "resource": "*:*_resource",
            "comparison": ">",
            "compare_to": 0
        }
    },
    "name": "Blaze of Glory",
    "description": "Float for 5 seconds in the air. For this duration, all projectiles you shoot will set your opponent on fire."
}