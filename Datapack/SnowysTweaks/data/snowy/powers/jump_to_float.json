{
    "type": "origins:multiple",
    "resource": {
        "type": "origins:resource",
        "min": 0,
        "max": 100
    },
    "key_press": {
        "type": "origins:active_self",
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:change_resource",
                    "resource": "*:*_jumps",
                    "change": -1
                },
                {
                    "type": "origins:add_velocity",
                    "space": "local_horizontal",
                    "z": 0.4,
                    "client": true,
                    "server": true
                },
                {
                    "type": "origins:add_velocity",
                    "space": "world",
                    "y": 0.7,
                    "client": true,
                    "server": true
                },
                {
                    "type": "origins:execute_command",
                    "command": "/particle cloud ~ ~ ~ 0.2 0 0.2 0 6 normal"
                },
                {
                    "type": "origins:play_sound",
                    "sound": "minecraft:entity.llama.spit",
                    "volume": 4,
                    "pitch": 0.3
                },
                {
                    "type": "origins:exhaust",
                    "amount": 1
                }
            ]
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:resource",
                    "resource": "*:*_resource",
                    "comparison": "==",
                    "compare_to": 0
                },
                {
                    "type": "origins:on_block",
                    "inverted": true
                },
                {
                    "type": "origins:in_block_anywhere",
                    "block_condition": {
                        "type": "origins:block",
                        "block": "water"
                    },
                    "comparison": ">=",
                    "compare_to": 1,
                    "inverted": true
                },
                {
                    "type": "origins:food_level",
                    "comparison": ">",
                    "compare_to": 6
                }
            ]
        },
        "key": {
            "key": "key.jump",
            "continuous": false
        },
        "hud_render": {
            "should_render": false
        },
        "cooldown": 200
    },
    "float": {
        "type": "origins:modify_falling",
        "velocity": -0.01,
        "take_fall_damage": true,
        "condition": {
            "type": "origins:resource",
            "resource": "*:*_resource",
            "comparison": ">",
            "compare_to": 0
        }
    },
    "cancel_fall_damage": {
        "type": "origins:invulnerability",
        "damage_condition": {
            "type": "origins:name",
            "name": "fall"
        },
        "condition": {
            "type": "origins:resource",
            "resource": "*:*_resource",
            "comparison": ">",
            "compare_to": 0
        }
    }
}