{
    "type": "origins:multiple",
    "jump": {
        "type": "origins:modify_jump",
        "modifier": {
            "name": "Bonus jump force while charged",
            "value": 3.0,
            "operation": "multiply_base"
        },
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:change_resource",
                    "resource": "*:*_air_speed_toggle",
                    "change": 1
                },
                {
                    "type": "origins:delay",
                    "ticks": 120,
                    "action": {
                        "type": "origins:change_resource",
                        "resource": "*:*_air_speed_toggle",
                        "change": -1
                    }
                },
                {
                    "type": "origins:change_resource",
                    "resource": "*:*_charge",
                    "change": -10
                },
                {
                    "type": "origins:exhaust",
                    "amount": 1
                }
            ]
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:sneaking"
                },
                {
                    "type": "origins:food_level",
                    "comparison": ">",
                    "compare_to": 6
                },
                {
                    "type": "origins:resource",
                    "resource": "*:*_charge",
                    "comparison": ">=",
                    "compare_to": 58
                },
                {
                    "type": "origins:on_block"
                }
            ]
        }
    },
    "air_speed_toggle": {
        "type": "origins:resource",
        "min": 0,
        "max": 1,
        "hud_render": {
            "should_render": false
        }
    },
    "air_speed": {
        "type": "origins:modify_air_speed",
        "modifier": {
            "operation": "multiply_total",
            "value": 1.4
        },
        "condition": {
            "type": "origins:resource",
            "resource": "*:*_air_speed_toggle",
            "comparison": "==",
            "compare_to": 1
        }
    },
    "charge": {
        "type": "origins:resource",
        "min": 0,
        "max": 60,
        "hud_render": {
            "sprite_location": "origins:textures/gui/community/huang/resource_bar_01.png",
            "bar_index": 3,
            "should_render": true,
            "condition": {
                "type": "origins:and",
                "conditions": [
                    {
                        "type": "origins:sneaking"
                    },
                    {
                        "type": "origins:on_block"
                    },
                    {
                        "type": "origins:food_level",
                        "comparison": ">",
                        "compare_to": 6
                    },
                    {
                        "type": "origins:resource",
                        "resource": "*:*_charge",
                        "comparison": ">=",
                        "compare_to": 6
                    }
                ]
            }
        }
    },
    "charge_over_time": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:if_else",
            "condition": {
                "type": "origins:and",
                "conditions": [
                    {
                        "type": "origins:sneaking"
                    },
                    {
                        "type": "origins:on_block"
                    }
                ]
            },
            "if_action": {
                "type": "origins:change_resource",
                "resource": "*:*_charge",
                "change": 2
            },
            "else_action": {
                "type": "origins:change_resource",
                "resource": "*:*_charge",
                "change": -100
            }
        },
        "interval": 2
    },
    "name": "Charged Leap",
    "description": "Leap into the air and bounce!",
    "badges": [
        {
            "sprite": "origins:textures/gui/badge/info.png",
            "text": "Crouch on the ground to charge the leap."
        }
    ]
}