{
    "type": "origins:multiple",
    "mount": {
        "type": "origins:action_on_being_used",
        "bientity_action": {
            "type": "origins:mount"
        },
        "bientity_condition": {
            "type": "origins:target_condition",
            "condition": {
                "type": "origins:passenger",
                "inverted": true
            }
        },
        "item_condition": {
            "type": "origins:empty"
        }
    },
    "dismount": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:passenger_action",
            "action": {
                "type": "origins:dismount"
            }
        },
        "interval": 5,
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:sneaking"
                },
                {
                    "type": "origins:passenger_recursive",
                    "comparison": ">=",
                    "compare_to": 1
                }
            ]
        }
    },
    "name": "Jockey",
    "description": "You can give other players a piggyback ride!"
}