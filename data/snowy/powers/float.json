{
    "type": "origins:multiple",
    "timer": {
        "type": "origins:resource",
        "min": 0,
        "max": 30,
        "start_value": 30,
        "hud_render": {
            "should_render": false
        },
        "hidden": true
    },
    "restore": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:if_else",
            "condition": {
                "type": "origins:on_block"
            },
            "if_action": {
                "type": "origins:change_resource",
                "resource": "*:*_timer",
                "change": -100
            },
            "else_action": {
                "type": "origins:change_resource",
                "resource": "*:*_timer",
                "change": 5
            }
        },
        "interval": 5
    },
    "float": {
        "type": "origins:active_self",
        "entity_action": {
            "type": "origins:apply_effect",
            "effect": {
                "effect": "minecraft:slow_falling",
                "duration": 60,
                "amplifier": 2
            }
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:on_block",
                    "inverted": true
                },
                {
                    "type": "origins:resource",
                    "resource": "*:*_timer",
                    "comparison": ">=",
                    "compare_to": 40
                }
            ]
        },
        "cooldown": 120,
        "key": {
            "key": "key.jump",
            "continuous": false
        },
        "hud_render": {
            "sprite_location": "origins:textures/gui/community/spiderkolo/resource_bar_03.png",
            "bar_index": 9,
            "should_render": true
        }
    },
    "name": "Float",
    "description": "Jump while midair to float for 3 seconds."
}